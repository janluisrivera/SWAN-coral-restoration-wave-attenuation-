PROJECT 'Parguera 3m Grid' ' '
'Parguera 3m resolution test'
'Bathymetry: Reduced 3m grid from 3m CUDEM'

MODE NONSTATIONARY TWODIMENSIONAL

SET DEPMIN 0.10 INRHOG 1 NAUTICAL
COORDINATES CARTESIAN

CGRID CURVILINEAR 283 449 EXC 9.999000e+003 &
       CIRCLE 36 0.04 1.0 20
READGRID COORDINATES 1 'E:\Swan_Projects\Parguera_Meters\Parg_m_ROI.grd' 4 0 0 FREE

INPGRID BOTTOM CURVILINEAR 0 0 283 449 EXC 9.999000e+003
READINP BOTTOM 1 'E:\Swan_Projects\Parguera_Meters\Bathymetry_SLR\Parg_m_ROI_Year3.bot' 4 0 FREE

INPGRID NPLANTS1 CURVILINEAR 0 0 283 449 EXC 9.999000e+003
READINP NPLANTS1 1 'E:\VegetationPatch_SWAN\Final_20yr_CoralVeg\Acropora_palmata\NPLANTS_patch.dat' 4 0 FREE
VEGetation 1 0.113 0.170 1 1.44
VEGetation 1 0.113 0.398 1 1.44

BOUNDPAR1 SHAPESPEC JONSWAP 3.3 PEAK DSPR DEGREES
BOUNDPAR2 SEGMENT IJ 283 0 283 449 CONSTANT 1.0 14.0 130.0 22.5
BOUNDPAR2 SEGMENT IJ 0 449 283 449 CONSTANT 1.0 14.0 130.0 22.5

GEN3
BREAKING CONSTANT 1.0 0.73
INPGRID FRICTION CURVILINEAR 0 0 283 449 EXC 9.999000e+003
READINP FRICTION 1 'D:\OutlineScripts\Months\MonthsFix\Good\Folder\Parg_m_friction_lt10m.dat' 4 0 FREE
FRICTION COLLINS
WCAP KOM 2.36E-5 3.02E-3 2.0 1.0 1.0
PROP BSBT
OFF QUAD

BLOCK 'COMPGRID' NOHEADER 'depth.mat'  LAY 4 DEPTH 1.    
BLOCK 'COMPGRID' NOHEADER 'hsig.mat'   LAY 4 HSIGN 1.    OUTPUT 20250720.000000 30 MIN
BLOCK 'COMPGRID' NOHEADER 'rtp.mat'    LAY 4 RTP 1.      OUTPUT 20250720.000000 30 MIN
BLOCK 'COMPGRID' NOHEADER 'wdir.mat'   LAY 4 DIR 1.      OUTPUT 20250720.000000 30 MIN
BLOCK 'COMPGRID' NOHEADER 'wlen.mat'   LAY 4 WLEN 1.     OUTPUT 20250720.000000 30 MIN    
BLOCK 'COMPGRID' NOHEADER 'xp.mat'     LAY 4 XP 1.       
BLOCK 'COMPGRID' NOHEADER 'yp.mat'     LAY 4 YP 1.        

POINTS 'point1' 702200.0 1984100.0
SPECOUT 'point1' SPEC1D ABS 'point1.spc1d' OUTPUT 20250720.000000 30 MIN
TABLE   'point1' HEADER 'point1.table' HSIGN DIR WLEN OUTPUT 20250720.000000 30 MIN



PROP BSBT

COMPUTE STATIONARY 20250720.000000


STOP